# Copy to .env. These are workshop credentials, never commit the filled file.
REDIS_URL=redis://default:password@host:port

# LangCache: create a cache during lab 2.
LANGCACHE_URL=https://your-langcache-host
LANGCACHE_CACHE_ID=
LANGCACHE_API_KEY=

# Agent Memory: create a service during lab 3.
MEMORY_ENDPOINT=https://your-memory-endpoint
MEMORY_STORE_ID=
MEMORY_API_KEY=

# Use a unique, non-sensitive ID if the instructor shares one Memory service.
WORKSHOP_USER_ID=change-me

# Context Retriever: get an admin key (see the lab 4 README).
# Python creates the service, entities, and fields using REDIS_URL.
# Leave CTX_SURFACE_ID blank initially; Python saves it here for reuse.
# An existing ID updates that service's model, keeping its database connection.
# Lab 4 creates its agent key in Python; no CTX_AGENT_KEY is needed here.
CTX_ADMIN_KEY=
CTX_SURFACE_ID=

