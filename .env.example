# Copy to .env. These are workshop credentials, never commit the filled file.
REDIS_URL=rediss://default:password@host:port

# Context Retriever: create these during lab 2.
CTX_ADMIN_KEY=
CTX_SURFACE_ID=
CTX_AGENT_KEY=

# LangCache: create a cache during lab 3.
LANGCACHE_URL=https://your-langcache-host
LANGCACHE_CACHE_ID=
LANGCACHE_API_KEY=

# Agent Memory: create a service during lab 4.
MEMORY_ENDPOINT=https://your-memory-endpoint
MEMORY_STORE_ID=
MEMORY_API_KEY=

# Use a unique, non-sensitive ID if the instructor shares one Memory service.
WORKSHOP_USER_ID=change-me
